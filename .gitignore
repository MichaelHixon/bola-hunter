# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Tool output / evidence — NEVER commit target or client data
*-run/
bola-run/
responses/
verdicts.csv
reports/
out/

# Local / personal (not committed)
ISA.md
CLAUDE.md
.env
.env.*
.DS_Store

# Local test lab (not committed)
.lab/
lab/

# Claude Code local config — machine-local settings stay out.
# settings.json is the exception: shared build/test permissions, no paths, no identity.
# The /* form is required: git cannot re-include a file under an excluded directory.
.claude/*
!.claude/settings.json
